diff --git a/app/routing/model_selector.py b/app/routing/model_selector.py
new file mode 100644
--- /dev/null
+++ b/app/routing/model_selector.py
@@
+import httpx
+
+class ModelSelectionError(Exception):
+    pass
+
+def required_capability(messages):
+    text = []
+    has_image = False
+    def scan(value):
+        nonlocal has_image
+        if isinstance(value, str):
+            text.append(value)
+        elif isinstance(value, dict):
+            kind = str(value.get('type', '')).lower()
+            if kind in {'image', 'image_url', 'input_image'} or 'image_url' in value or 'image' in value:
+                has_image = True
+            for child in value.values():
+                if isinstance(child, (dict, list, str)): scan(child)
+        elif isinstance(value, list):
+            for child in value: scan(child)
+    for message in messages: scan(message.content)
+    if has_image: return 'vision'
+    joined = '\n'.join(text).lower()
+    signals = ('```', 'def ', 'class ', 'function ', 'select ', 'insert ', 'update ', 'delete ', 'python', 'javascript', 'typescript', 'c#', 'asp.net', 'sql', 'کدنویسی', 'برنامه نویسی', 'برنامه‌نویسی', 'دیباگ', 'کامپایل', 'تابع', 'کلاس', 'کد بنویس', 'کد را', 'کد رو')
+    return 'coding' if any(signal in joined for signal in signals) else 'chat'
+
+async def select_model(registry, settings, messages):
+    capability = required_capability(messages)
+    try:
+        async with httpx.AsyncClient(timeout=10) as client:
+            response = await client.get(
+                f"{settings.dynamo_base_url.rstrip('/')}/models",
+                headers={'Authorization': f"Bearer {settings.dynamo_api_key.get_secret_value()}"},
+            )
+            response.raise_for_status()
+            runtime_models = response.json().get('data', [])
+    except (httpx.HTTPError, ValueError) as exc:
+        raise ModelSelectionError('Model provider unavailable') from exc
+    runtime_ids = {item.get('id') for item in runtime_models if isinstance(item, dict) and item.get('id')}
+    try:
+        registry_models = await registry.list_models()
+    except Exception as exc:
+        raise ModelSelectionError('Model registry unavailable') from exc
+    for model in registry_models:
+        if model[6] == 'approved' and model[7] and model[0] in runtime_ids and capability in (model[11] or []):
+            return model[0]
+    raise ModelSelectionError(f'No approved and enabled runtime model supports capability: {capability}')
